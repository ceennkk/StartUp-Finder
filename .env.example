# Neon: use the pooled connection string here. Scheme may be postgresql:// (rewritten to psycopg automatically).
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
# Optional: direct (non-pooled) Neon URL, used for Alembic migrations.
DATABASE_URL_DIRECT=
# Local Docker database for tests: docker compose up -d (use 127.0.0.1; "localhost" can stall on IPv6)
TEST_DATABASE_URL=postgresql+psycopg://ventureradar:ventureradar@127.0.0.1:5433/ventureradar_test

# Required for the GitHub adapter (fine-grained or classic PAT, public read access is enough).
GITHUB_TOKEN=
# Optional but recommended: free key from https://openalex.org/settings/api-key
OPENALEX_API_KEY=
# Optional for Hugging Face (public endpoints work without it).
HF_TOKEN=

# Sent in the User-Agent so API operators can contact you.
CONTACT_EMAIL=
HTTP_TIMEOUT_SECONDS=30
LOG_LEVEL=INFO
# json | text
LOG_FORMAT=json
# Directory with local CSV/JSON files for the manual_import collector (default: data/manual_imports). Keep it git-ignored.
MANUAL_IMPORT_DIR=
# Observations are bucketed to this granularity (day | hour).
OBSERVATION_BUCKET=day
