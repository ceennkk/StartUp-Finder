# Offline synthetic preview
APP_MODE=demo
DATABASE_URL=sqlite:///data/demo.sqlite3
HOST=127.0.0.1
PORT=8000
API_TOKEN=
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Live: APP_MODE=live, PostgreSQL URL, API_TOKEN and provider credentials
# DATABASE_URL=postgresql://startup:your-password@localhost:5432/startup
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-this-password
GRAPHITI_GROUP_ID=startup_finder_de
GRAPHITI_TELEMETRY_ENABLED=false
SEMAPHORE_LIMIT=3

# off | jev | openai; requires compatible upstream Graphiti build
DECISION_PROVIDER=off
JEV_API_KEY=
JEV_MODEL=jev-latest
OPENAI_DECISIONS_MODEL=
GRAPHITI_CLIENT_FACTORY=

POSTGRES_USER=startup
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_DB=startup
