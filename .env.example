# PostgreSQL (Neon or local). Use the pooled URL for DATABASE_URL;
# migrations may use a direct connection through DATABASE_URL_DIRECT.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
TEST_DATABASE_URL=postgresql+psycopg://ventureradar:ventureradar@127.0.0.1:5433/ventureradar_test

# Collector adapters
GITHUB_TOKEN=
OPENALEX_API_KEY=
HF_TOKEN=
CONTACT_EMAIL=
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=3
LOG_LEVEL=INFO
LOG_FORMAT=json
OBSERVATION_BUCKET=day

# Startup Finder API / worker
APP_MODE=live
HOST=127.0.0.1
PORT=8000
API_TOKEN=
CORS_ORIGINS=http://localhost:3000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
GRAPHITI_GROUP_ID=startup_finder_de
GRAPHITI_TELEMETRY_ENABLED=false
SEMAPHORE_LIMIT=3
DECISION_PROVIDER=openai
OPENAI_DECISIONS_MODEL=gpt-6-luna
JEV_API_KEY=
JEV_MODEL=jev-latest
GRAPHITI_CLIENT_FACTORY=

# Local Docker PostgreSQL defaults
POSTGRES_USER=startup
POSTGRES_PASSWORD=
POSTGRES_DB=startup

# Manual import files (local only)
MANUAL_IMPORT_DIR=data/manual_imports
